    },
    {
      "parameters": {
        "jsCode": "const body = $json.body;\nconst args = body.message?.toolCalls?.[0]?.function?.arguments || {};\n\nconst name = args.name || 'Student';\nconst dateStr = args.date; // YYYY-MM-DD\nconst timeStr = args.time; // HH:MM\n\nif (!dateStr || !timeStr) {\n  return {\n    json: {\n      isValidDay: false,\n      isValidTime: false,\n      reason: 'Missing date or time'\n    }\n  };\n}\n\n// Date Parse\nconst reqDate = new Date(`${dateStr}T${timeStr}:00`);\nconst dayNumber = reqDate.getDay(); // 0 = Sun, 1 = Mon, 3 = Wed, 5 = Fri\nconst hour = parseInt(timeStr.split(':')[0], 10);\n\n// Rule 1: Mon (1), Wed (3), Fri (5)\nconst isValidDay = [1, 3, 5].includes(dayNumber);\n\n// Rule 2: Time between 16:00 and 19:00 (since 1hr duration, last slot ends at 20:00)\nconst isValidTime = hour >= 16 && hour < 20;\n\n// Event Start & End\nconst startISO = `${dateStr}T${timeStr}:00.000Z`;\nconst endHour = hour + 1;\nconst endHourStr = endHour < 10 ? `0${endHour}` : `${endHour}`;\nconst endISO = `${dateStr}T${endHourStr}:${timeStr.split(':')[1]}:00.000Z`;\n\nreturn {\n  json: {\n    name,\n    dateStr,\n    timeStr,\n    isValidDay,\n    isValidTime,\n    startISO,\n    endISO\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
